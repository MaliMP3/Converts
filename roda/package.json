{
  "name": "roda",
  "productName": "Converts",
  "version": "1.0.0",
  "private": true,
  "description": "Converts, conversor de arquivos no estilo de um menu radial",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "dependencies": {
    "docx": "^9.5.1",
    "ffmpeg-static": "^5.3.0",
    "mammoth": "^1.9.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.roda.arquivos",
    "productName": "Converts",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist{,/**}",
      "!roda.log"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": "portable",
      "artifactName": "Converts.exe",
      "signAndEditExecutable": false
    }
  }
}
